{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-build.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "if": "Bash(git commit)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-docs.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
